# manifesto of a recovering arch refugee whose getdents64 syscall got hooked by an orphaned pkgbuild
# fleeing directly into functional isolation so npm install atomic-lockfile can never touch bare metal again.

{ config, pkgs, lib, inputs, ... }:

let
  fanControlPkg = pkgs.callPackage ../pkgs/fan-control {};
in
{
  imports =
    [ # hardware autopsy autogenerated by nixos-generate-config so we know which silicon we are abusing
      ./hardware-configuration.nix
    ];

  # 1. bootloader & boot graphics: masking the sins of the kernel behind an oem logo
  boot.loader.systemd-boot.enable = lib.mkForce false;
  boot.lanzaboote = {
    enable = true;
    pkiBundle = "/var/lib/sbctl";
  };
  boot.loader.systemd-boot.configurationLimit = 10;
  boot.loader.efi.canTouchEfiVariables = true;
  boot.loader.timeout = 5; # timeout in seconds so you can choose Windows Boot Manager
  boot.kernelPackages = pkgs.linuxPackages_latest;

  # plymouth bgrt: visual lobotomy so we don't have to watch acpi error traces flash across the screen
  boot.plymouth = {
    enable = true;
    theme = "bgrt";
  };

  # early kms: keep the oem lenovo logo alive without display pipe resets
  boot.initrd.kernelModules = [ "i915" ];

  # muzzle dmesg into absolute silence because ignorance is the only true form of stability
  boot.consoleLogLevel = 0;
  boot.kernelParams = [
    "quiet"
    "splash"
    "i915.fastboot=1"
    "boot.shell_on_fail"
    "loglevel=3"
    "rd.systemd.show_status=false"
    "rd.udev.log_level=3"
    "udev.log_priority=3"
  ];

  # unlock thinkpad acpi fan control so userspace daemons can manipulate ec registers without kernel eperm
  boot.extraModprobeConfig = ''
    options thinkpad_acpi fan_control=1
  '';

  # 1.5 power containment: public execution of power-profiles-daemon before tlp murders it in cold blood
  services.power-profiles-daemon.enable = false;
  
  # ThinkPad T16 Gen 1 (i7-1260p + MX550) specialized containment grid
  services.tlp = {
    enable = true;
    settings = {
      # Intel Alder Lake (i7-1260P): use powersave governor with intel_pstate HWP
      # Governor sets active scaling mode; EPP governs the actual frequency curve
      CPU_SCALING_GOVERNOR_ON_AC = "powersave";
      CPU_SCALING_GOVERNOR_ON_BAT = "powersave";
      
      # Energy Performance Preference: balance_performance on AC, balance_power on battery
      # Never use "power" on Alder Lake hybrid architecture unless you enjoy 400MHz sludge
      CPU_ENERGY_PERF_POLICY_ON_AC = "balance_performance";
      CPU_ENERGY_PERF_POLICY_ON_BAT = "balance_power";

      # Dynamic boost: allow burst performance on battery so UI doesn't stutter
      CPU_BOOST_ON_AC = 1;
      CPU_BOOST_ON_BAT = 1;
      CPU_HWP_DYNAMIC_BOOST_ON_AC = 1;
      CPU_HWP_DYNAMIC_BOOST_ON_BAT = 0;

      # Platform profile sync with Lenovo DYTC ACPI firmware
      PLATFORM_PROFILE_ON_AC = "performance";
      PLATFORM_PROFILE_ON_BAT = "balanced";

      # Intel Iris Xe Graphics: full 1400MHz clock ceiling so Hyprland stays 60fps on battery
      INTEL_GPU_MIN_FREQ_ON_AC = 300;
      INTEL_GPU_MIN_FREQ_ON_BAT = 300;
      INTEL_GPU_MAX_FREQ_ON_AC = 1400;
      INTEL_GPU_MAX_FREQ_ON_BAT = 1400;
      INTEL_GPU_BOOST_FREQ_ON_AC = 1400;
      INTEL_GPU_BOOST_FREQ_ON_BAT = 1400;

      # Allow Nvidia MX550 to sleep in runtime power management when idle
      RUNTIME_PM_ON_AC = "auto";
      RUNTIME_PM_ON_BAT = "auto";

      # PCIe ASPM & Audio power save
      PCIE_ASPM_ON_AC = "default";
      PCIE_ASPM_ON_BAT = "powersave";
      SOUND_POWER_SAVE_ON_AC = 1;
      SOUND_POWER_SAVE_ON_BAT = 1;

      # ThinkPad charge mechanics: start charging below 75%, stop at 80% to preserve cell health
      START_CHARGE_THRESH_BAT0 = 75;
      STOP_CHARGE_THRESH_BAT0 = 80;
    };
  };

  # 1.6 battery telemetry: so quickshell can watch our li-ion cells degrade in real-time without tlp declaring war
  services.upower.enable = true;

  # 1.7 thinkpad ec fan control & 400mhz lock unstick watchdog daemon
  services.dbus.packages = [ fanControlPkg ];

  systemd.services.fan-control = {
    description = "ThinkPad fan curve and 400MHz lock unstick daemon";
    after = [ "dbus.service" ];
    wantedBy = [ "multi-user.target" ];
    serviceConfig = {
      Type = "simple";
      ExecStart = "${fanControlPkg}/bin/fan-control-daemon";
      Restart = "always";
      RestartSec = 3;
    };
  };

  # 1.7 thermal & flash longevity: protecting silicon from our questionable lifestyle choices
  # note: thinkpad_acpi dytc already governs thermals in firmware, so we let lenovo ec handle cooling
  services.fstrim = {
    enable = true; # reminding the nvme controller that dead blocks exist so write speeds don't decay into a floppy drive
    interval = "weekly";
  };
  services.btrfs.autoScrub = {
    enable = true; # periodic checksum audit so silent bitrot doesn't corrupt our unfinished side projects
    interval = "monthly";
    fileSystems = [ "/" ];
  };

  # zram compression: trapping memory leaks in compressed ram so swap thrashing doesn't murder nvme endurance
  zramSwap = {
    enable = true;
    algorithm = "zstd";
    memoryPercent = 50;
    priority = 100;
  };

  # 2. networking: broadcasting our existential dread directly to the local subnet
  networking.hostName = "lost"; # accurate diagnostic status of the user and their root partition
  networking.networkmanager.enable = true;

  # 3. chronobiology: pretending time is real and localized to the midwest
  time.timeZone = "America/Chicago";
  i18n.defaultLocale = "en_US.UTF-8";
  i18n.extraLocaleSettings = {
    LC_ADDRESS = "en_US.UTF-8";
    LC_IDENTIFICATION = "en_US.UTF-8";
    LC_MEASUREMENT = "en_US.UTF-8";
    LC_MONETARY = "en_US.UTF-8";
    LC_NAME = "en_US.UTF-8";
    LC_NUMERIC = "en_US.UTF-8";
    LC_PAPER = "en_US.UTF-8";
    LC_TELEPHONE = "en_US.UTF-8";
    LC_TIME = "en_US.UTF-8";
  };

  # 4. display manager: bloatware emergency shelter for when hyprland commits suicide on a minor release
  services.xserver.enable = true;
  services.displayManager.sddm.enable = true;
  services.desktopManager.gnome.enable = true; # emotional support desktop environment for wayland casualties

  environment.gnome.excludePackages = with pkgs; [
    baobab
    decibels
    epiphany
    geary
    gnome-calendar
    gnome-characters
    gnome-clocks
    gnome-connections
    gnome-console
    gnome-contacts
    gnome-font-viewer
    gnome-initial-setup
    gnome-logs
    gnome-maps
    gnome-music
    gnome-software
    gnome-system-monitor
    gnome-text-editor
    gnome-tour
    gnome-user-docs
    gnome-weather
    loupe
    papers
    seahorse
    showtime
    simple-scan
    snapshot
    totem
    yelp
  ];

  services.xserver.excludePackages = [ pkgs.xterm ];

  services.xserver.xkb = {
    layout = "us";
    variant = "";
  };

  # flatpak on nixos: ideological treason, running bubblewrap containers inside a read-only store
  services.flatpak.enable = true;

  # 5. window manager: held together by uwsm and unresolved emotional trauma
  programs.hyprland = {
    enable = true;
    withUWSM = true; # systemd putting a leash on the compositor so it stops leaking zombie procs into the void
  };

  # 6. audio plumbing: pulseaudio corpse buried in an unmarked shallow grave
  services.printing.enable = false; # no printer has ever existed in this room and cups is evicted
  services.pulseaudio.enable = false; # salt the earth where pulseaudio once stood
  security.rtkit.enable = true;
  services.pipewire = {
    enable = true;
    alsa.enable = true;
    alsa.support32Bit = true;
    pulse.enable = true;
    wireplumber.enable = true;
  };
  hardware.bluetooth.enable = true;

  # 7. user definition: ashley, who typed 'yay -s' without reading the pkgbuild and invited an ebpf rootkit to live rent-free in memory
  users.mutableUsers = false;
  users.users."ashley" = {
    isNormalUser = true;
    description = "ashley";
    extraGroups = [ "networkmanager" "wheel" "video" "audio" ];
    shell = pkgs.zsh;
    hashedPasswordFile = "/persist/etc/shadow-ashley";
  };
  users.users."root".hashedPasswordFile = "/persist/etc/shadow-root";

  # passwordless sudo so typing passwords during endless rebuilds stops draining the remaining will to live
  security.sudo.wheelNeedsPassword = false;

  # 8. flakes & experimental hubris: drinking the deterministic kool-aid to forget mutable state ever existed
  programs.firefox.enable = true;
  programs.zsh.enable = true;
  nixpkgs.config.allowUnfree = true;
  nix.settings.experimental-features = [ "nix-command" "flakes" ];
  nix.settings.auto-optimise-store = true;
  nix.gc = {
    automatic = true;
    dates = "weekly";
    options = "--delete-older-than 3d";
  };

  # journal & documentation containment: keeping logs and static html from rotting in storage
  services.journald.settings.Journal = {
    SystemMaxUse = "100M";
  };
  documentation.nixos.enable = false;
  documentation.doc.enable = false;

  # 9. obs studio: virtual camera plumbing wrapped tightly so v4l2 doesn't leak into the abyss
  programs.obs-studio = {
    enable = true;
    enableVirtualCamera = true; # loops kernel modules without contaminating the functional closure
    plugins = with pkgs.obs-studio-plugins; [
      obs-pipewire-audio-capture # praying to the wireplumber daemon that audio streams actually bind
    ];
  };
  security.polkit.enable = true; # paying the security toll so systemd stops denying camera permissions out of spite

  # 9.2 shadowplay mimicry: capturing pixels straight out of kms before they hitting wayland compositor space
  programs.gpu-screen-recorder = {
    enable = true;
    ui.enable = true; # installs gpu-screen-recorder-gtk frontend safely with appropriate capabilities
  };

  # 9.5 portal plumbing: preventing screen share from streaming an infinite recursive void into discord
  xdg.portal = {
    enable = true;
    extraPortals = [ pkgs.xdg-desktop-portal-gtk ];
    config.common.default = [ "hyprland" "gtk" ];
  };

  # 10. digital hoarder collection: terminal toys to look like a cinematic hacker while nix rebuilds world
  environment.systemPackages = with pkgs; [
    sbctl
    efibootmgr

    # wayland rice tooling
    kitty
    git
    quickshell
    matugen
    adw-gtk3
    awww
    mpvpaper
    hyprpicker
    wl-clipboard
    brightnessctl
    playerctl

    # brain shell sensory organs & capture plumbing
    imagemagick       # palette generation so matugen can extract aesthetic dopamine from wallpapers
    libnotify         # toast alerts so we know when background processes silently crash
    cliphist          # clipboard hoarding mechanism for things we copied and immediately forgot
    grim              # screenshot engine to memorialize our broken configs
    slurp             # screen coordinate surveyor
    wf-recorder       # screen recording so we can submit bug reports to github issues at 3 am
    wtype             # simulated keystroke injection for widgets pretending to be a keyboard

    # terminal cosplay to pretend we understand rust cli tooling
    micro
    neovim
    fastfetch
    eza
    zoxide
    fzf
    bat
    ripgrep
    fd
    jq
    yazi

    # glue scripts and image manipulation dependencies
    python3
    python3Packages.pillow
    ffmpeg            # so wallpaper scripts stop screaming into the void when extracting video thumbnails

    # ps4 theme extraction contraband
    unar

    # identity verification for the hub
    gh

    # i want to see my specs though
    inxi

    # i need a way on how to use the 5tb of google ai pro before next year
    rclone

    # i want btop
    btop

    # thinkpad fan curve and thermal control (gui + cli)
    fanControlPkg

    # gnome tweaks and emotional support extensions for when hyprland breaks
    gnome-tweaks
    gnomeExtensions.blur-my-shell
    gnomeExtensions.dash-to-dock
    gnomeExtensions.appindicator

    # antigravity cli compiled directly into system closure from flake input
    inputs.antigravity-nix.packages.${pkgs.stdenv.hostPlatform.system}.google-antigravity-cli
  ];

  # 11. typography: sacrificial glyphs to keep unicode tofu rectangles from infesting waybar
  fonts.packages = with pkgs; [
    nerd-fonts.jetbrains-mono
    noto-fonts
    noto-fonts-cjk-sans
    noto-fonts-color-emoji
  ];

  # 12. ephemeral root & impermanence: erase your darlings
  # everything in / is volatile ram. only explicit state survives in /persist.
  programs.fuse.userAllowOther = true;
  environment.persistence."/persist" = {
    hideMounts = true;
    directories = [
      "/var/lib/nixos"
      "/var/lib/bluetooth"
      "/var/lib/sbctl"
      "/var/lib/upower"
      "/var/lib/systemd"
      "/etc/NetworkManager/system-connections"
      "/etc/nixos"
    ];
    files = [
      "/etc/machine-id"
    ];
  };

  # touch this value and the ghost of atomic-lockfile crawls out of /nix/store to revoke your sudo privileges
  system.stateVersion = "26.05";
}
