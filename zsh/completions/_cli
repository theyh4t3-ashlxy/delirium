#compdef cli qs-switch

local curcontext="$curcontext" state line
typeset -A opt_args

local -a commands=(
    'doctor:run desktop, matugen, ansi, btop, and zsh health diagnostics'
    'theme:show active wallpaper, mode/scheme, ansi blocks & kitty preview'
    'palette:alias for theme'
    'clean:remove stale quickshell runtime pid dirs'
    'logs:tail active quickshell or brain_shell runtime log'
    'shell:switch or toggle active shell (quickshell <-> brain_shell)'
    'qs:shortcut to switch to standard quickshell'
    'bs:shortcut to switch to brain_shell'
    'reload:gracefully reload active shell or gnome matugen themes'
    'restart:gracefully reload active shell or gnome matugen themes'
    'kill:kill running shell instances'
    'stop:kill running shell instances'
    'status:show active desktop/shell, pids, theme mode, and memory'
    'version:show desktop, shell runtime, and theme summary'
    'info:show active desktop/shell info'
    'launcher:toggle app launcher or gnome overview'
    'dashboard:toggle dashboard / quicksettings'
    'quicksettings:toggle quicksettings'
    'notifs:toggle notification center'
    'dnd:toggle do not disturb (quickshell & gnome)'
    'clip:toggle clipboard history'
    'notes:toggle quick notes / kanban'
    'files:open preferred file manager'
    'wp:roll wallpaper or pass subcommands to wp'
    'wall:roll random wallpaper & regenerate tokens'
    'audio:open audio control'
    'mixer:toggle audio mixer'
    'mic:toggle microphone popup'
    'media:toggle now playing popup'
    'wifi:network controls'
    'bt:bluetooth controls'
    'vpn:vpn toggle'
    'hotspot:wireless hotspot toggle'
    'capture:open screen capture studio / gnome screenshot'
    'ss:open screenshot studio / gnome screenshot'
    'screenshot:capture screenshot'
    'pick:sample screen pixel hex color and copy'
    'eyedropper:sample screen pixel hex color and copy'
    'record:screen recording controls'
    'studio:open bar studio'
    'motion:open bar studio motion sandbox'
    'caffeine:toggle sleep inhibitor popup'
    'lock:lock session'
    'power:open power menu'
    'stats:open stats / btop'
    'btop:launch btop'
    'config:open shell settings or gnome control center'
    'keybinds:view keybindings cheatsheet'
    'welcome:open welcome wizard'
    'act:dispatch arbitrary shell action'
    'ipc:raw pass-through to quickshell ipc'
)

_arguments -C \
    '--json[emit json output]' \
    '--no-img[skip inline kitty wallpaper preview]' \
    '--no-color[disable ansi colors]' \
    '--force[bypass nonewprivs reload guard]' \
    '--fix[auto-repair safe issues in doctor]' \
    '1: :->command' \
    '*: :->args'

case $state in
    command)
        _describe -t commands 'cli subcommand' commands
        ;;
    args)
        case $line[1] in
            shell|switch|toggle|t)
                local -a targets=(
                    'qs:standard quickshell'
                    'bs:brain_shell'
                    'toggle:toggle between shells'
                    'restart:restart active shell'
                )
                _describe -t targets 'shell target' targets
                ;;
            record|rec)
                local -a rec_cmds=(
                    'screen:record entire screen'
                    'region:record selected region'
                    'window:record active window'
                    'stop:stop active recording'
                    'discard:discard active recording'
                )
                _describe -t rec_cmds 'record action' rec_cmds
                ;;
            wp|wallpaper|wall|w)
                local -a wp_cmds=(
                    'status:show active wallpaper & palette'
                    'dark:switch to dark mode'
                    'light:switch to light mode'
                    'toggle:toggle dark/light mode'
                    'random:roll random local wallpaper'
                    'wh:roll online wallpaper from wallhaven'
                    'scheme:switch matugen scheme'
                    'reload:reapply current wallpaper & colors'
                    'scan:rescan wallpaper folders'
                )
                _describe -t wp_cmds 'wp action' wp_cmds
                ;;
            logs|log)
                local -a log_opts=('-f:follow log stream' '40:last 40 lines' '100:last 100 lines')
                _describe -t log_opts 'log option' log_opts
                ;;
            files|fm|e)
                _directories
                ;;
            act|action)
                local -a acts=(
                    'launcher:app launcher'
                    'dashboard:quicksettings / dashboard'
                    'notifs:notifications'
                    'dnd:do not disturb'
                    'clipboard:clipboard manager'
                    'capture:screen capture panel'
                    'files:file manager'
                    'wallpaper:roll wallpaper'
                    'caffeine:sleep inhibitor'
                    'powermenu:power menu'
                    'keybinds:cheatsheet'
                    'welcome:welcome wizard'
                )
                _describe -t acts 'action' acts
                ;;
            *)
                return 0
                ;;
        esac
        ;;
esac
