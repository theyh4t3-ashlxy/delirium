{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "color": {
      "title": "blue",
      "keys": "cyan",
      "separator": "bright_black",
      "output": "white"
    },
    "separator": " 󰅂 ",
    "key": {
      "width": 14
    }
  },
  "logo": {
    "source": "auto",
    "color": {
      "1": "blue",
      "2": "cyan",
      "3": "magenta",
      "4": "bright_blue",
      "5": "bright_cyan",
      "6": "bright_magenta",
      "7": "bright_black",
      "8": "black",
      "9": "white"
    },
    "padding": {
      "right": 4
    }
  },
  "modules": [
    { "type": "title" },
    "separator",
    { "type": "os", "key": " os" },
    { "type": "host", "key": "󰌢 host", "format": "{version}" },
    { "type": "kernel", "key": "󰌽 kernel" },
    { "type": "uptime", "key": "󰅐 uptime" },
    { "type": "packages", "key": "󰏖 pkgs" },
    { "type": "shell", "key": "󰞷 shell" },
    { "type": "wm", "key": "󱂬 wm" },
    { "type": "terminal", "key": "󰞍 term" },
    { "type": "cpu", "key": "󰍛 cpu" },
    { "type": "memory", "key": "󰘚 mem" },
    { "type": "disk", "key": "󰋊 disk" },
    { "type": "battery", "key": "󰂄 bat", "format": "{capacity} [{status}]" },
    "break",
    { "type": "colors", "symbol": "circle" }
  ]
}
