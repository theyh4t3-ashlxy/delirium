{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "display": {
    "color": {
      "title": "blue",
      "keys": "cyan",
      "separator": "90",
      "output": "white"
    },
    "separator": "· ",
    "bar": {
      "char": {
        "elapsed": "━",
        "total": "─"
      },
      "border": {
        "left": "",
        "right": ""
      },
      "width": 10,
      "color": {
        "total": "90"
      }
    },
    "percent": {
      "type": 3
    },
    "duration": {
      "abbreviation": true
    },
    "size": {
      "ndigits": 1
    },
    "temp": {
      "unit": "C",
      "ndigits": 0
    }
  },
  "logo": {
    "color": {
      "1": "blue",
      "2": "cyan",
      "3": "magenta",
      "4": "bright_blue",
      "5": "bright_cyan",
      "6": "bright_magenta",
      "7": "90",
      "8": "90",
      "9": "white"
    },
    "padding": {
      "top": 0,
      "right": 4
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{#blue}{user-name}{#90}@{#cyan}{host-name}{#90}  •  {#magenta}{home-dir}"
    },
    {
      "type": "custom",
      "format": "{#90}────────────────────────────────────────────"
    },
    {
      "type": "os",
      "key": "╭─  os     ",
      "keyColor": "blue",
      "format": "{pretty-name} {arch}"
    },
    {
      "type": "host",
      "key": "│  󰌢 host   ",
      "keyColor": "blue",
      "format": "{version}"
    },
    {
      "type": "kernel",
      "key": "│  󰌽 kernel ",
      "keyColor": "blue",
      "format": "{sysname} {release}"
    },
    {
      "type": "packages",
      "key": "│  󰏖 pkgs   ",
      "keyColor": "blue",
      "format": "{nix-all} nix {#90}• {#white}{flatpak-all} flatpak"
    },
    {
      "type": "uptime",
      "key": "╰─ 󰅐 uptime ",
      "keyColor": "blue"
    },
    {
      "type": "wm",
      "key": "╭─ 󱂬 wm     ",
      "keyColor": "magenta",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "terminal",
      "key": "│  󰞍 term   ",
      "keyColor": "magenta"
    },
    {
      "type": "shell",
      "key": "╰─ 󰞷 shell  ",
      "keyColor": "magenta"
    },
    {
      "type": "cpu",
      "key": "╭─ 󰍛 cpu    ",
      "keyColor": "cyan",
      "temp": true,
      "format": "{name} @ {freq-max} {#90}[{#}{temperature}{#90}]"
    },
    {
      "type": "gpu",
      "key": "│  󰢮 gpu    ",
      "keyColor": "cyan",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "│  󰘚 mem    ",
      "keyColor": "cyan",
      "format": "{used} / {total}  {percentage-bar} {percentage}"
    },
    {
      "type": "disk",
      "key": "│  󰋊 disk   ",
      "keyColor": "cyan",
      "folders": "/home",
      "format": "{size-used} / {size-total}  {size-percentage-bar} {size-percentage}"
    },
    {
      "type": "battery",
      "key": "╰─ 󰂄 bat    ",
      "keyColor": "cyan",
      "format": "{capacity}  {capacity-bar} {#90}[{#white}{status}{#90}]"
    },
    "break",
    {
      "type": "colors",
      "paddingLeft": 14,
      "symbol": "circle"
    }
  ]
}
